# Copy to .env.test (gitignored) before running the backend test suite.
#
#   cp .env.test.example .env.test
#
# The tests use a REAL Prisma client — nothing is mocked — and they create and
# delete rows. This must point at a throwaway local database, never at a shared
# or hosted one. src/__tests__/setup.ts refuses to run if it detects a known
# hosted provider in the URL.
#
# Start the database first, from the repo root:
#   docker compose up -d db
#
# Port 5433, not 5432: docker-compose.yml publishes it there so it cannot
# collide with a Postgres already running locally.

DATABASE_URL="postgresql://annotex:annotex@localhost:5433/annotex_db?schema=public"

# Prisma reads DIRECT_URL for migrations (prisma.config.ts), DATABASE_URL for
# queries. Both are needed, and for a local database they are the same.
DIRECT_URL="postgresql://annotex:annotex@localhost:5433/annotex_db?schema=public"
